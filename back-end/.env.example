# Database Configuration
DB_HOST=your-supabase-db-host.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password
DB_NAME=postgres
DB_SSL=true

# Auth Configuration
JWT_SECRET=your-super-secret-key
JWT_EXPIRATION=3600s

# Redis Configuration (Optional for now)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration (Optional for now)
RABBITMQ_URL=amqp://user:password@localhost:5672

# App Configuration
PORT=3000

# Zalo Mini App — exchange số điện thoại (graph.zalo.me)
# Ưu tiên set trực tiếp trên server/CI (không commit giá trị thật vào git).
# ZALO_APP_SECRET=...
# ZALO_APP_ID=... (tuỳ chọn; code hiện chủ yếu dùng secret_key khi gọi graph)
# Nếu không set ZALO_APP_SECRET, gateway sẽ GET URL dưới để lấy secretKey (cache vài phút).
# ZALO_CREDENTIALS_URL=https://qrcert.vietqr.vn/api/key/zalo
# ZALO_CREDENTIALS_CACHE_MS=300000

# Zalo Mini App — webhook rút consent (user.revoke.consent)
# Console → Thiết lập chung → Webhook URL:
#   https://tingo-api-gateway.vietqr.vn/api/zalo/webhook/consent-revoke
# Open API key (Console → Open API) — ưu tiên cho verify X-ZEvent-Signature.
# Nếu không set, fallback ZALO_APP_SECRET hoặc ZALO_CREDENTIALS_URL.
# ZALO_OPEN_API_KEY=...
# Chỉ dùng local/dev khi chưa có key (KHÔNG bật trên production):
# ZALO_WEBHOOK_SKIP_VERIFY=true

# Zalo ↔ Tingo Pay account link (bảng zalo_account_links)
# API (Bearer = token V1 từ login):
#   POST   /api/zalo/account-link          body: { zaloUserId, appId? }
#          409 ZALO_LINKED_OTHER_TINGO | TINGO_LINKED_OTHER_ZALO (1 Zalo ↔ 1 Tingo)
#   DELETE /api/zalo/account-link          body: { zaloUserId? }
#   GET    /api/zalo/account-link/status?zaloUserId=...
#   GET    /api/zalo/account-link/status-public?zaloUserId=...  (welcome auto-login, no bearer)
# Webhook consent-revoke sẽ set status=REVOKED_BY_CONSENT theo zalo_user_id.

# Tingo Pay phone+PIN auth BFF (parity Mobile/Web V2):
#   POST /api/tingo/auth/login     { phone, pin }
#   GET  /api/tingo/auth/phone-status?phone=
#   POST /api/tingo/auth/register  { phone, pin }
# Upstream: api.vietqr.org/vqr/api/accounts(+register/search) + dev-v2.vietqr.vn/auth/login
# PIN encrypt: HMAC-SHA256(key=phone, data=pin)

# Chỉ đặt true ở máy dev để mở /auth/login và /auth/register (không xác thực). KHÔNG đặt trên production.
ENABLE_DEBUG_AUTH=false

# Thanh toán chuyển khoản VietQR (điền giá trị thật ở .env, KHÔNG commit)
# ENABLE_DEBUG_PAYMENT=true chỉ ở máy dev: mở /orders/:id/dev-mark-paid và dựng mã QR cục bộ. KHÔNG đặt trên production.
ENABLE_DEBUG_PAYMENT=false
VIETQR_API_BASE=
VIETQR_BASIC_AUTH=
VIETQR_TOKEN_PATH=
VIETQR_CALLBACK_USER=
VIETQR_CALLBACK_PASS=
VIETQR_CALLBACK_JWT_SECRET=
VIETQR_BANK_CODE=MB
VIETQR_BANK_BIN=970422
VIETQR_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=

# Lưu ảnh báo hỏng thiết bị bằng Supabase Storage (điền giá trị thật ở .env, KHÔNG commit).
# Chưa điền đủ 3 dòng dưới thì tự lưu tạm ra ổ đĩa container như trước (chỉ để dev).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=device-issues
